ENV="local"
PROJECT_DB_ENGINE="postgres"
PROJECT_DB_HOST="localhost"
PROJECT_DB_NAME="fitness_app"
PROJECT_DB_PASS="root"
PROJECT_DB_PORT=5432
PROJECT_DB_USER="root"
PROJECT_ID="myApp"
PROJECT_NAME="My app"
SYSTEM_DB_ENGINE="badger"

#SYSTEM_DB_ENGINE=postgres
#PROJECT_DB_ENGINE=postgres

COOKIE_DOMAIN=apito.io
CORS_ORIGIN=https://app.apito.io

# General
SERVE_PORT=5050
TLS=false
TLS_PORT=4443
CRT_KEY=/go/src/gitlab.com/apito.io/engine/keys/certkey.key
CRT=/go/src/gitlab.com/apito.io/engine/keys/cert.crt

PUBLIC_KEY=/go/src/gitlab.com/apito.io/engine/keys/public.key
PRIVATE_KEY=/go/src/gitlab.com/apito.io/engine/keys/private.key

# Auth Provider
AUTH_SERVICE_PROVIDER=local
TOKEN_TTL=60

# KV Engine
KV_ENGINE_HOST=localhost
KV_ENGINE_PORT=6379
KV_ENGINE_PASSWORD=
KV_ENGINE_DATABASE=0
KV_ENGINE_USER=none